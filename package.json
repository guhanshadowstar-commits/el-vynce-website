{
  "name": "el-vynce-website",
  "version": "1.0.0",
  "private": true,
  "description": "EL VYNCE static site. Tailwind is compiled to css/tailwind.css (no runtime CDN).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.17"
  }
}
